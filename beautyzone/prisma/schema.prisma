generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  nombre    String
  estado    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  idrol     Int
  nombre    String
  apellido  String
  correo    String   @unique
  password  String
  telefono  String?
  estado    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pinCaja   String?  @unique @db.VarChar(6)
  // Contraseña dedicada para operaciones sensibles (editar arqueos, cierre
  // administrativo). Es independiente del `password` de inicio de sesión.
  passwordAdmin String? @map("password_admin") @db.VarChar(100)

  rol                    Role           @relation(fields: [idrol], references: [id])
  citasCliente           Cita[]         @relation("CitaCliente")
  detallesCitaEstilista  DetalleCita[]  @relation("EstilistaServicio")
  ventasCliente          Venta[]        @relation("VentaCliente")
  ventasCajero           Venta[]        @relation("VentaCajero")
  detallesVentaEstilista DetalleVenta[] @relation("EstilistaDetalleVenta")
  comisiones             Comision[]
  asistencias            Asistencia[]
  cajasAperturadas       CajaTurno[]    @relation("CajeroTurno")
  cierresAdministrativos  CierreAdministrativo[] @relation("AdminCierre")
  bitacoras              Bitacora[]     @relation("BitacoraUsuario")

  @@map("usuarios")
}

/// Registro de auditoría: quién hizo qué, cuándo, desde dónde IP.
///
/// Es de solo agregado (append-only): no tiene `updatedAt` y ninguna ruta de la
/// aplicación permite editar o borrar entradas.
model Bitacora {
  id Int @id @default(autoincrement())

  // NULL cuando la acción no se pudo atribuir a un usuario (por ejemplo, un
  // intento de login con un correo inexistente).
  idusuario    Int?     @map("id_usuario")
  usuario      Usuario? @relation("BitacoraUsuario", fields: [idusuario], references: [id], onDelete: SetNull)

  // Verbos en pasado, p. ej. "CREO", "ACTUALIZO", "ELIMINO", "INICIO_SESION".
  accion      String
  // Entidad afectada, p. ej. "Usuario", "Venta", "CajaTurno".
  entidad     String
  entidadId   String?  @map("entidad_id")
  descripcion String

  // Contexto de la petición y valores antes/después del cambio.
  datos       Json?
  metodo      String?
  ruta        String?
  ip          String?  @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(400)
  // "EXITO" o "FALLO".
  resultado   String   @default("EXITO")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([idusuario])
  @@index([accion, entidad])
  @@index([entidad, entidadId])
  @@map("bitacora")
}


model Categoria {
  id        Int      @id @default(autoincrement())
  nombre    String
  tipo      String   // 'SERVICIO' o 'PRODUCTO'
  estado    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  servicios Servicio[]
  productos Producto[]

  @@map("categorias")
}

model Servicio {
  id          Int     @id @default(autoincrement())
  idcategoria Int
  nombre      String
  descripcion String?
  precio      Decimal @db.Decimal(10, 2)
  // La comisión se guarda en la misma columna según `tipoComision`: un
  // porcentaje del precio o un monto fijo. Por eso Decimal(10, 2) y no (5, 2),
  // que se quedaría corto en el modo monto.
  porcentajeComision Decimal @default(0.00) @map("porcentaje_comision") @db.Decimal(10, 2)
  // "PORCENTAJE" o "MONTO".
  tipoComision       String  @default("PORCENTAJE") @map("tipo_comision")
  imagen             String?
  estado             Boolean @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  categoria     Categoria      @relation(fields: [idcategoria], references: [id])
  detallesCita  DetalleCita[]
  detallesVenta DetalleVenta[]

  @@map("servicios")
}

model Producto {
  id          Int            @id @default(autoincrement())
  idcategoria Int
  nombre      String
  descripcion String?
  precio      Decimal        @db.Decimal(10, 2)
  stock       Int            @default(0)
  stockMinimo Int?           @default(5) @map("stock_minimo")
  estado      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  categoria     Categoria      @relation(fields: [idcategoria], references: [id])
  detallesVenta DetalleVenta[]

  @@map("productos")
}

model Cita {
  id         Int      @id @default(autoincrement())
  idcliente  Int
  fecha      DateTime @db.Date
  horaInicio String   @map("hora_inicio") // Formato "HH:mm"
  estado     String   @default("PENDIENTE") // PENDIENTE, CONFIRMADA, EN_PROCESO, FINALIZADA, CANCELADA
  notas      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cliente      Usuario       @relation("CitaCliente", fields: [idcliente], references: [id])
  detallesCita DetalleCita[]
  ventas       Venta[]

  @@map("citas")
}

model DetalleCita {
  id              Int      @id @default(autoincrement())
  idcita          Int
  idservicio      Int
  idestilista     Int
  precioHistorico Decimal  @map("precio_historico") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  cita      Cita     @relation(fields: [idcita], references: [id])
  servicio  Servicio @relation(fields: [idservicio], references: [id])
  estilista Usuario  @relation("EstilistaServicio", fields: [idestilista], references: [id])

  @@map("detalle_citas")
}

// NUEVO: Control del Turno / Apertura y Cierre de Caja
model CajaTurno {
  id                  Int       @id @default(autoincrement())
  idcajero            Int       @map("idcajero")
  nombreCaja          String    @default("Caja Principal") @map("nombre_caja")
  passwordPin         String    @map("password_pin")
  montoApertura       Decimal   @map("monto_apertura") @db.Decimal(10, 2)
  montoCierreEsperado Decimal?  @map("monto_cierre_esperado") @db.Decimal(10, 2)
  montoCierreReal     Decimal?  @map("monto_cierre_real") @db.Decimal(10, 2)
  diferencia          Decimal?  @db.Decimal(10, 2) // Sobrante (+) o Faltante (-)
  estado              String    @default("ABIERTA") // ABIERTA, CERRADA
  fechaApertura       DateTime  @default(now()) @map("fecha_apertura")
  fechaCierre         DateTime? @map("fecha_cierre")

  cajero              Usuario             @relation("CajeroTurno", fields: [idcajero], references: [id])
  ventas              Venta[]
  arqueoDenominacion  ArqueoDenominacion?

  @@map("caja_turnos")
}

model Venta {
  id             Int      @id @default(autoincrement())
  idcliente      Int?
  idempleadoCaja Int      @map("idempleado_caja")
  idcajaTurno    Int?     @map("idcaja_turno") // NUEVO: Vinculación con el turno activo
  idcita         Int?
  total          Decimal  @db.Decimal(10, 2)
  metodoPago     String   @map("metodo_pago") // EFECTIVO, TARJETA, TRANSFERENCIA
  estado         String   @default("PAGADO") // PAGADO, ANULADO
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cliente      Usuario?      @relation("VentaCliente", fields: [idcliente], references: [id])
  empleadoCaja Usuario       @relation("VentaCajero", fields: [idempleadoCaja], references: [id])
  cajaTurno    CajaTurno?    @relation(fields: [idcajaTurno], references: [id])
  cita         Cita?         @relation(fields: [idcita], references: [id])
  detallesVenta DetalleVenta[]

  @@map("ventas")
}

// NUEVO: Conteo detallado de Monedas, Billetes y Otros pagos para el Cierre
model ArqueoDenominacion {
  id                 Int       @id @default(autoincrement())
  idcajaTurno        Int       @unique @map("idcaja_turno")
  // Billetes
  b100               Int       @default(0)
  b50                Int       @default(0)
  b20                Int       @default(0)
  b10                Int       @default(0)
  b5                 Int       @default(0)
  b1                 Int       @default(0)
  // Monedas
  m100               Int       @default(0) // Moneda de $1.00
  m025               Int       @default(0) // $0.25
  m010               Int       @default(0) // $0.10
  m005               Int       @default(0) // $0.05
  m001               Int       @default(0) // $0.01
  // Otros Métodos
  totalTarjeta       Decimal   @default(0.00) @map("total_tarjeta") @db.Decimal(10, 2)
  totalTransferencia Decimal   @default(0.00) @map("total_transferencia") @db.Decimal(10, 2)
  totalEfectivoContado Decimal @default(0.00) @map("total_efectivo_contado") @db.Decimal(10, 2)
  createdAt          DateTime  @default(now()) @map("created_at")

  cajaTurno          CajaTurno @relation(fields: [idcajaTurno], references: [id])

  @@map("arqueo_denominaciones")
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  idventa        Int
  idproducto     Int?
  idservicio     Int?
  idestilista    Int?
  cantidad       Int      @default(1)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  venta      Venta     @relation(fields: [idventa], references: [id])
  producto   Producto? @relation(fields: [idproducto], references: [id])
  servicio   Servicio? @relation(fields: [idservicio], references: [id])
  estilista  Usuario?  @relation("EstilistaDetalleVenta", fields: [idestilista], references: [id])
  comisiones Comision[]

  @@map("detalle_ventas")
}

model Comision {
  id             Int      @id @default(autoincrement())
  idestilista    Int
  iddetalleVenta Int      @map("iddetalle_venta")
  montoComision  Decimal  @map("monto_comision") @db.Decimal(10, 2)
  estado         String   @default("PENDIENTE") // PENDIENTE, PAGADO
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  estilista    Usuario      @relation(fields: [idestilista], references: [id])
  detalleVenta DetalleVenta @relation(fields: [iddetalleVenta], references: [id])

  @@map("comisiones")
}

model Asistencia {
  id           Int      @id @default(autoincrement())
  idempleado   Int
  fecha        DateTime @db.Date
  hora         String   // Formato "14:30"
  tipoRegistro String   @map("tipo_registro")
  createdAt    DateTime @default(now()) @map("created_at")

  empleado Usuario @relation(fields: [idempleado], references: [id])

  @@map("asistencias")
}

// Cierre administrativo: el conteo final que hace la persona administradora
// sobre la suma del efectivo de TODAS las cajas del día, menos los gastos que
// se pagaron en efectivo (luz, agua, etc). Solo se permite uno por día.
model CierreAdministrativo {
  id            Int      @id @default(autoincrement())
  idadmin       Int      @map("id_admin")
  fecha         DateTime @db.Date
  // Suma del efectivo esperado de cada caja cerrada del día (apertura + ventas
  // en efectivo de cada turno). Se recalcula al leer, no se confía en el cliente.
  totalCajas    Decimal  @default(0.00) @map("total_cajas") @db.Decimal(10, 2)
  // Suma de los gastos del día pagados con efectivo.
  totalGastos   Decimal  @default(0.00) @map("total_gastos") @db.Decimal(10, 2)
  // Lo que la administradora debería tener en mano: totalCajas - totalGastos.
  totalEsperado Decimal  @default(0.00) @map("total_esperado") @db.Decimal(10, 2)
  // Conteo físico final. Nulo hasta que se realiza el conteo.
  montoReal     Decimal? @map("monto_real") @db.Decimal(10, 2)
  diferencia    Decimal? @db.Decimal(10, 2) // Sobrante (+) o Faltante (-)
  estado        String   @default("PENDIENTE") // PENDIENTE, REALIZADO
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  admin         Usuario                  @relation("AdminCierre", fields: [idadmin], references: [id])
  gastos        GastoCierre[]
  denominaciones DenominacionCierreAdmin?

  @@unique([fecha])
  @@map("cierres_administrativos")
}

// Facturas pagadas con efectivo el día del cierre (luz, agua, internet...).
// Se descuentan solos del total esperado que debe tener la administradora.
model GastoCierre {
  id                Int      @id @default(autoincrement())
  idcierreAdmin     Int      @map("id_cierre_admin")
  tipo              String // LUZ, AGUA, INTERNET, etc (texto libre del catalogo)
  numeroComprobante String?  @map("numero_comprobante")
  monto             Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  cierreAdmin CierreAdministrativo @relation(fields: [idcierreAdmin], references: [id], onDelete: Cascade)

  @@map("gastos_cierre")
}

// Conteo por denominación del cierre administrativo. Espejo de
// ArqueoDenominacion, pero colgado del cierre y no de un turno de caja.
model DenominacionCierreAdmin {
  id                Int      @id @default(autoincrement())
  idcierreAdmin     Int      @unique @map("id_cierre_admin")
  // Billetes
  b100              Int      @default(0)
  b50               Int      @default(0)
  b20               Int      @default(0)
  b10               Int      @default(0)
  b5                Int      @default(0)
  b1                Int      @default(0)
  // Monedas
  m100              Int      @default(0) // Moneda de $1.00
  m025              Int      @default(0) // $0.25
  m010              Int      @default(0) // $0.10
  m005              Int      @default(0) // $0.05
  m001              Int      @default(0) // $0.01
  totalContado      Decimal  @default(0.00) @map("total_contado") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  cierreAdmin CierreAdministrativo @relation(fields: [idcierreAdmin], references: [id], onDelete: Cascade)

  @@map("denominaciones_cierre_admin")
}
// Programacion del respaldo automatico. Es una sola fila (id 1): el admin
// decide dia, hora y frecuencia, y el servidor la revisa cada minuto.
// Frecuencia: DIARIO, SEMANAL, MENSUAL.
model BackupConfig {
  id             Int       @id @default(1)
  frecuencia     String    @default("DIARIO")
  diaSemana      Int       @default(1) // 0=domingo ... 6=sabado (solo SEMANAL)
  diaMes         Int       @default(1) // 1..28 (solo MENSUAL)
  hora           Int       @default(2) // 0..23
  minuto         Int       @default(0) // 0..59
  activo         Boolean   @default(true)
  ultimoEjecutado DateTime? @map("ultimo_ejecutado")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("backup_config")
}

// Un respaldo en disco (volcado .sql hecho con pg_dump). Solo se conservan los
// MAXIMO_BACKUPS mas recientes: al crear uno nuevo se borran los anteriores.
model Backup {
  id            Int       @id @default(autoincrement())
  archivo       String
  ruta          String
  tamanoBytes   Int       @default(0) @map("tamano_bytes")
  estado        String    @default("PENDIENTE") // PENDIENTE, EXITOSO, ERROR
  mensaje       String?
  origen        String    @default("MANUAL") // MANUAL, PROGRAMADO
  iniciadoEn    DateTime  @default(now()) @map("iniciado_en")
  finalizadoEn DateTime? @map("finalizado_en")
  creadoEn      DateTime  @default(now()) @map("creado_en")

  @@index([creadoEn])
  @@map("backups")
}
